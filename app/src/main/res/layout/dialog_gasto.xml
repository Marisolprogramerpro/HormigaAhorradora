<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalles del Gasto"
            android:textColor="@color/verde_principal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Concepto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Concepto *"
            android:textColor="@color/gris_oscuro"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etConcepto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:hint="Ej: Supermercado"
            android:inputType="textCapSentences"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Monto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monto ($) *"
            android:textColor="@color/gris_oscuro"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etMonto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Fecha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha *"
            android:textColor="@color/gris_oscuro"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etFecha"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:hint="Toca para seleccionar"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Nota (opcional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nota (opcional)"
            android:textColor="@color/gris_oscuro"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etNota"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:hint="Ej: Compra semanal"
            android:inputType="textCapSentences"
            android:paddingHorizontal="16dp"/>

    </LinearLayout>
</ScrollView>