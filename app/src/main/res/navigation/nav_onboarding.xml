<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_onboarding"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.hormigaahorradora.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_loginFragment_to_registro"
            app:destination="@id/registro" />
        <action
            android:id="@+id/action_loginFragment_to_recuperacion"
            app:destination="@id/recuperacion" />
    </fragment>
    <fragment
        android:id="@+id/registro"
        android:name="com.example.hormigaahorradora.Registro"
        android:label="fragment_registro"
        tools:layout="@layout/fragment_registro" >
        <action
            android:id="@+id/action_registro_to_registroDatos"
            app:destination="@id/registroDatos" />
    </fragment>
    <fragment
        android:id="@+id/recuperacion"
        android:name="com.example.hormigaahorradora.Recuperacion"
        android:label="fragment_recuperacion"
        tools:layout="@layout/fragment_recuperacion" />
    <fragment
        android:id="@+id/registroDatos"
        android:name="com.example.hormigaahorradora.RegistroDatos"
        android:label="fragment_registro_datos"
        tools:layout="@layout/fragment_registro_datos" >
        <action
            android:id="@+id/action_registroDatos_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.hormigaahorradora.homeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" />
</navigation>