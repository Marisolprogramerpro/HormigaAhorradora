<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.hormigaahorradora.ui.fragments.HomeFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home">
        <!-- Acción hacia el detalle de categoría -->
        <action
            android:id="@+id/action_homeFragment_to_categoriaDetailFragment"
            app:destination="@id/categoriaDetailFragment"/>
    </fragment>

    <fragment
        android:id="@+id/resumenFragment"
        android:name="com.example.hormigaahorradora.ui.fragments.ResumenFragment"
        android:label="Resumen"
        tools:layout="@layout/fragment_resumen"/>

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.hormigaahorradora.ui.fragments.AccountFragment"
        android:label="Cuenta"
        tools:layout="@layout/fragment_account"/>

    <!-- NUEVO: pantalla de detalle de categoría -->
    <fragment
        android:id="@+id/categoriaDetailFragment"
        android:name="com.example.hormigaahorradora.ui.fragments.CategoriaDetailFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_categoria_detail">
        <argument
            android:name="categoria"
            app:argType="com.example.hormigaahorradora.core.model.Categoria"/>
    </fragment>

</navigation>